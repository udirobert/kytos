# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv-science/
.venv-cleveland/
.venv-eval2/
venv/


# Cell-eval / anndata intermediates
*.h5ad.lock

# Submission packages and large prediction matrices (source is the script; the
# binary artifacts live on HF / the VCC leaderboard, not in git).
*.vcc
*.npz
experiments/**/*.h5ad

# Large data / models (not committed; fetch scripts in data/)
data/raw/
data/cleveland/raw/
/models/
*.onnx
*.safetensors
*.bin

# Editor / OS
.DS_Store
*.swp

# Local secrets (copy from .env.example)
.env
.env.local
.env.*.local

# Agent config (local)
.kilo/
.qoder/

# Observatory build output (generated locally; Netlify builds on push)
frontend/dist/

# Generated pipeline artifacts — these change on every run and should not
# be committed. Regenerate via `tools/run_enrichment.sh` in CI or locally.
experiments/*/verification/narrative_check.json
experiments/*/pipeline_status.json

# Throwaway scratch (my one-off tooltip-reveal harness; rebroadcast renders)
.tmp/

# Pioneer model ID cache (local; not committed — per-account)
tools/.pioneer_model_id

# Generated media assets — Netlify builds on push, so small clips are committed.
# The size cap (4MB) that decides committability lives in
# tools/_enrich_common.py (media_committable) + frontend/build.py — the
# gitignore must NOT use a blanket "*" or it silently hides new source/experiment
# files. Only paths never to be committed are listed here.
broadcast-desk/
experiments/**/visual/briefing.mp4
# HyperFrames clip projects — source is committed, build artifacts are not.
chronicle/*/node_modules/
chronicle/*/package-lock.json
chronicle/*/renders/
chronicle/*/snapshots/
chronicle/*/.hyperframes/
chronicle/*/assets/anchor*.mp4
chronicle/*/assets/vo-full.mp3
chronicle/*/.thumbnails/
chronicle/*/.waveform-cache/
data/raw/refs/
# Competition embargo (until the Oct 22 final test set): experiment results,
# score tables, and findings stay local. Code and infra still push.
experiments/_embargoed/
experiments/k020-gnn-crosslineage/gnn.pt
experiments/k018-h1-dualmoment/modal_build.pid
