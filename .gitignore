# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv-science/
venv/

# Cell-eval / anndata intermediates
*.h5ad.lock

# Large data / models (not committed; fetch scripts in data/)
data/raw/
/models/
*.onnx
*.safetensors
*.bin

# Editor / OS
.DS_Store
*.swp

# Local secrets (copy from .env.example)
.env
.env.local
.env.*.local

# Observatory build output (generated locally; Netlify builds on push)
frontend/dist/

# Throwaway scratch (my one-off tooltip-reveal harness; rebroadcast renders)
.tmp/

# Pioneer model ID cache (local; not committed — per-account)
tools/.pioneer_model_id

# Generated media assets — Netlify builds on push, so small clips are committed.
# The size cap (4MB) that decides committability lives in
# tools/_enrich_common.py (media_committable) + frontend/build.py — the
# gitignore must NOT use a blanket "*" or it silently hides new source/experiment
# files. Only paths never to be committed are listed here.
broadcast-desk/
experiments/**/visual/briefing.mp4