# Kytos partner API keys — copy to `.env` and fill in (never commit `.env`).
#
#   cp .env.example .env
#
# Loaded automatically by `./tools/run_enrichment.sh`.
# For Netlify production, set the same variables in Site → Environment variables.

# ── Narration provider ─────────────────────────────────────────────────────
# venice = local dev (OpenAI-compatible, private inference, no hackathon burn)
# openai = hackathon / production (Netlify)
# See docs/venice-dev.md for privacy modes and setup.
NARRATION_PROVIDER=venice

# ── Venice (dev narration — OpenAI-compatible API) ─────────────────────────
# https://venice.ai · https://docs.venice.ai/overview/privacy
# Inference keys: dashboard → API. Do not commit; keep in `.env` only.

VENICE_INFERENCE_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=stealth-ox-alpha

# ── OpenAI (hackathon narration + TTS) ─────────────────────────────────────
# Leave empty during local dev if using Venice above.
# Hackathon: codes sent to your Luma-linked email.

OPENAI_API_KEY=

# Optional — hackathon / proxy gateway (chat completions only)
# OPENAI_BASE_URL=https://opengateway.gitlawb.com/v1
# OPENAI_MODEL=mindai/macaron-v1-tall

# Fabric briefing TTS — direct api.openai.com only (not Venice, not chat gateways)
OPENAI_TTS_API_KEY=

# ── Tavily (literature rail) ───────────────────────────────────────────────
# Sign up at https://tavily.com — hackathon code: AugustLondon

TAVILY_API_KEY=

# ── fal (hero stills + VEED Fabric briefing) ───────────────────────────────
# Voucher: techeuropexfal-london — https://fal.ai/dashboard/billing

FAL_KEY=
# FAL_API_KEY=   # alias also accepted

# ── Pioneer (optional side challenge) ──────────────────────────────────────
# PIONEER_API_KEY=
# PIONEER_MODEL_ID=
